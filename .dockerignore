# Keep the build context small and — more importantly — keep secrets and
# local state out of the image.

# dependencies / build output (rebuilt inside the image)
node_modules
.next
dist
out
build
coverage
*.tsbuildinfo
next-env.d.ts

# VCS, CI and editor/tool state
.git
.github
.claude
.vscode
.idea
.DS_Store

# every env file (.env, .env.local, .env.production, ...). Configuration is
# injected at runtime via compose `env_file`; nothing secret may be baked in.
.env*
!.env.example

# not needed to build or run the app
tests
test-results
playwright-report
*.md
docker-compose*.yml
npm-debug.log*
