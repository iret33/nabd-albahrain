# This file models PRODUCTION defaults (matching docker-compose.yml, where
# the app container reaches Postgres over the Docker network at the "db"
# service name). For local dev (`pnpm dev` running on your host, not in
# Docker), put overrides in .env.local — see the README's "Local
# development" section.

DATABASE_URL=postgresql://nabd:nabd@db:5432/nabd
# (docker-compose.yml overrides this for the app container: it appends
# `?connection_limit=${DB_POOL_SIZE:-12}`, see "Resource limits" below. Outside
# Docker add the parameter yourself if the default pool is too small.)

# --- Secrets: REQUIRED in production, generate each with `openssl rand -hex 32`.
# The production container refuses to start with blank, placeholder, short
# (<32 chars) or identical values. ADMIN_TOKEN is the /admin login password;
# SYNC_TOKEN is the bearer token for POST /api/sync (cron / scripts).
ADMIN_TOKEN=
SYNC_TOKEN=

# Public base URL (canonical links, sitemap, OG tags, public-refresh origin check).
NEXT_PUBLIC_SITE_URL=https://data.hekkapp.com

# --- Data freshness ---------------------------------------------------------
# Built-in scheduler: how often (minutes) the web process checks the portal's
# catalog and re-syncs datasets that changed. 0 / unset = off (use cron).
AUTO_SYNC_INTERVAL_MINUTES=360
# Public "refresh" button (POST /api/refresh). 0 disables it entirely.
PUBLIC_REFRESH_ENABLED=1
# Cooldowns (seconds) enforced in the database, shared by all visitors.
PUBLIC_REFRESH_CATALOG_COOLDOWN_SECONDS=120
PUBLIC_REFRESH_DATASET_COOLDOWN_SECONDS=600
# Public refreshes never download datasets larger than this many rows
# (the scheduled/admin sync handles them).
PUBLIC_REFRESH_MAX_RECORDS=100000
# Safety-net TTL (seconds) on every cached query, so any out-of-band change
# (CLI sync, restore) becomes visible without a restart.
CACHE_TTL_SECONDS=300
# URL the sync engine uses to tell the running web server to drop its caches
# after a run (defaults to http://127.0.0.1:$PORT).
# APP_INTERNAL_URL=http://127.0.0.1:3000

# --- Sync engine ------------------------------------------------------------
SYNC_CONCURRENCY=3
# Point the sync at another OpenDataSoft API (e.g. the offline mock:
# `pnpm mock:ods` then ODS_BASE_URL=http://127.0.0.1:4010/api/explore/v2.1).
# ODS_BASE_URL=https://data.gov.bh/api/explore/v2.1

# MUST be 1 behind the Cloudflare Tunnel / a reverse proxy that sets
# cf-connecting-ip: login, sync-API and public-refresh rate limits then key on
# the real client IP. With 0 every visitor shares one bucket (an attacker could
# lock everyone out of /admin/login for 15 minutes).
TRUST_PROXY=1

# Admin sessions are signed (HMAC) and last 12h. By default the signing key is
# derived from ADMIN_TOKEN (rotating it logs everyone out); set a separate
# >=32-char random value to decouple them.
# SESSION_SECRET=
#
# /admin needs HTTPS (or loopback). In production the session cookie is Secure
# and `__Host-` prefixed, which browsers refuse to store over plain http, so
# signing in at http://<lan-or-public-ip>:3000 cannot work (the login page warns
# about it). Use the Cloudflare Tunnel's https:// hostname, or reach the server
# through http://localhost / http://127.0.0.1 (an SSH tunnel is fine). Safari
# does not store Secure cookies on http://localhost either: use https there, or
# `pnpm dev`, whose cookie is not Secure.

# --- Resource limits (docker-compose.yml reads these; all optional) ----------
# Prisma pool size for the app. At least SYNC_CONCURRENCY + 6 (the app warns at
# start when it is smaller): each dataset being synced pins one connection for
# its whole write transaction and the heartbeat, progress writer,
# /api/freshness and page queries need the rest.
# Prisma's own default is 2*vCPUs+1 (3 on a 1-vCPU VPS), which a heavy sync can
# exhaust (P2024 timeouts, HTTP 500s). Do not "fix" that with a longer
# pool_timeout.
# DB_POOL_SIZE=12
# Node flags for the app container. A V8 heap cap makes memory growth fail fast
# instead of swapping; three 300k-row datasets in flight were measured at a
# ~0.6-0.8 GB process peak (RSS, Next baseline included). Pair the cap with
# APP_MEM_LIMIT of at least heap + 300-400 MB (Prisma engine, response buffers,
# Next baseline): ~1.5 GB for the lines below. A limit under ~1.2 GB with
# SYNC_CONCURRENCY >= 3 gets OOM-killed mid-sync, which strands the sync lock
# for the 10-minute stale window.
# APP_NODE_OPTIONS=--max-old-space-size=1024
# APP_MEM_LIMIT=1536m
# The first sync after deploy downloads every dataset: run it as a one-off
# container (own pool, own memory, same DB lock) before the tunnel is live:
#   docker compose run --rm app sync
#
# GIT_SHA (the revision shown as `version` by /api/health/ready) is a BUILD arg:
# pass it on the command line, do not put it in this file (a stale value here
# would report the wrong build):
#   GIT_SHA=$(git rev-parse --short HEAD) docker compose up -d --build

# Password of the bundled Postgres (docker-compose reads it; DATABASE_URL for
# the compose app is derived from it). Use hex (`openssl rand -hex 16`) - it is
# placed in a URL. The default matches databases created by older versions; for
# a NEW database set a random value BEFORE the first `docker compose up`.
# POSTGRES_PASSWORD=nabd

# Optional sync tunables (defaults shown).
# SYNC_DELAY_MS=250
# SYNC_REQUEST_TIMEOUT_MS=30000
# SYNC_EXPORT_TIMEOUT_MS=120000
# SYNC_RETRY_BASE_MS=1000
