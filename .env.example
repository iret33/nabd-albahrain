# Nabd Al-Bahrain configuration template. Copy to `.env` and edit:  cp .env.example .env
#
# This file models PRODUCTION (docker-compose.yml: the app container reaches
# Postgres over the compose network at the service name "db"). For local
# development on your host (`pnpm dev`, no Docker for the app) change the values
# marked [dev] below; the README's "Local development" section has the recipe.
#
# Who reads `.env`:
#   - docker compose (`env_file`, and the build/compose variables further down)
#   - `pnpm dev` / `next start` (Next.js loads `.env` and `.env.local`)
#   - the Prisma CLI (`pnpm db:deploy`, `pnpm db:migrate`, `pnpm db:studio`) -- it
#     reads `.env` ONLY, never `.env.local`, so keep DATABASE_URL in `.env`
#   NOT the sync CLI: `pnpm sync` (tsx) and `pnpm test` never read any env file.
#   Export the variables first (`set -a; . ./.env; set +a`) or use
#   `pnpm exec tsx --env-file=.env src/lib/sync/cli.ts <flags>`.
#
# Unset or empty means "use the default shown". A commented line shows the default.
# Numeric tunables: garbage falls back to the default and an out-of-range number is
# clamped, both with a warning in the log. In production the server (and, for the
# secrets, the container entrypoint) additionally REFUSES TO START, printing every
# problem at once, on: a weak/missing ADMIN_TOKEN, SYNC_TOKEN or SESSION_SECRET,
# identical tokens, a non-postgres DATABASE_URL, SYNC_CONCURRENCY outside 1..10, a
# non-numeric or negative AUTO_SYNC_INTERVAL_MINUTES / CACHE_TTL_SECONDS /
# PUBLIC_REFRESH_* number, an unrecognised PUBLIC_REFRESH_ENABLED, TRUST_PROXY not 0/1.

# --- Database ----------------------------------------------------------------
# [dev] postgresql://nabd:nabd@localhost:5432/nabd
# Under docker compose this value is IGNORED for the app container: compose
# derives its own from POSTGRES_PASSWORD and DB_POOL_SIZE (see the end of the
# file) and sets `?connection_limit=` on it. Outside Docker add
# `?connection_limit=N` yourself (N >= SYNC_CONCURRENCY + 6); Prisma's own default
# pool is 2 x vCPUs + 1 (3 on a 1-vCPU VPS), which a heavy sync can exhaust.
DATABASE_URL=postgresql://nabd:nabd@db:5432/nabd

# --- Secrets: REQUIRED in production, generate each with `openssl rand -hex 32` -
# The production container refuses to start with a blank, placeholder-looking
# (`change-me*`, `dev-*`, `test-*`, `your-*`, `example*`, anything containing
# `password`), shorter-than-32-characters or low-entropy value, or when the two
# are identical. Left blank here ON PURPOSE: a blank value makes a careless copy
# fail loudly instead of running with a guessable secret. [dev] any non-empty
# value works when NODE_ENV is not production (an empty ADMIN_TOKEN disables the
# admin login, an empty SYNC_TOKEN disables bearer-token calls to the sync API
# and the cache-invalidation call after a sync, which then logs
# "[notify] SYNC_TOKEN is not set"). Never reuse your dev `.env` on a server.
#   ADMIN_TOKEN  the /admin login password
#   SYNC_TOKEN   bearer token for POST /api/sync and POST /api/revalidate (cron,
#                scripts); also what the sync engine uses to tell the web server
#                to drop its caches after a run
ADMIN_TOKEN=
SYNC_TOKEN=
# Admin sessions are signed (HMAC) and last 12 hours. By default the signing key
# is derived from ADMIN_TOKEN, so rotating ADMIN_TOKEN logs everyone out. Set a
# separate value (>= 32 random characters, same rules as above) to decouple them;
# then rotate THIS to log everyone out. There is no server-side session store.
# SESSION_SECRET=
#
# /admin needs HTTPS (or loopback). In production the session cookie is Secure
# and `__Host-` prefixed, which browsers refuse to store over plain http, so
# signing in at http://<lan-or-public-ip>:3000 cannot work (the login page warns
# about it). Use the Cloudflare Tunnel's https:// hostname, or reach the server
# through http://localhost / http://127.0.0.1 (an SSH tunnel is fine). Safari
# does not store Secure cookies on http://localhost either: use https there, or
# `pnpm dev`, whose cookie is not Secure.

# --- Public site -------------------------------------------------------------
# Public origin: canonical links, sitemap, Open Graph tags, feed, API links, and
# the Origin check of POST /api/refresh. [dev] http://localhost:3000
# It is BOTH a Docker build arg (docker-compose.yml passes it to the build, where
# the static robots.txt bakes it into its "Sitemap:" line) AND a runtime variable
# (dynamic pages read it per request). Changing it needs
# `docker compose up -d --build`.
NEXT_PUBLIC_SITE_URL=https://data.hekkapp.com

# MUST be 1 behind the Cloudflare Tunnel (or any proxy that sets CF-Connecting-IP
# and that visitors cannot bypass): login, sync-API, public-refresh and API rate
# limits then key on the real client IP (ONLY the CF-Connecting-IP header is
# used; X-Forwarded-For is ignored). With 0 every visitor shares one bucket, so a
# handful of requests can lock everyone out of /admin/login for 15 minutes.
# Must be exactly 0 or 1 (`true`/`yes` are rejected at boot). Unset is read as 0
# and logs a boot warning. Never set 1 when the app is exposed directly: the
# header could then be spoofed. [dev] 0 (or unset).
TRUST_PROXY=1

# --- Data freshness ----------------------------------------------------------
# Built-in scheduler: how often (minutes, 0..10080) the web process checks the
# portal's catalog and re-syncs datasets that changed. The CODE default is 0 =
# off, so this line is what turns it on (use host cron instead if you prefer; see
# the README). The first check runs ~60 s after boot and, on an empty database,
# is a full first sync. Data counts as "stale" (/api/freshness, /api/health/ready)
# after twice this interval, or after 48 h when it is 0.
# [dev] set 0 unless you want `pnpm dev` to start syncing about a minute after boot.
AUTO_SYNC_INTERVAL_MINUTES=360
# Seconds (0..3600) between boot and the scheduler's first check; up to 15 s of
# random jitter is added. Mostly a test knob.
# AUTO_SYNC_FIRST_DELAY_SECONDS=60

# Public "check for new data" button (POST /api/refresh), the kill switch. Accepted
# spellings (case-insensitive): 0 / false / no / off (disabled: the endpoint answers
# 503 and the buttons disappear) and 1 / true / yes / on (enabled). Blank or unset
# is enabled. Anything else is rejected at boot in production, and read as OFF at
# runtime elsewhere (it fails closed).
PUBLIC_REFRESH_ENABLED=1
# Cooldowns (seconds, 0..86400) enforced in the database, shared by ALL visitors:
# one catalog-wide check at most every 120 s, one refresh per dataset at most every 600 s.
PUBLIC_REFRESH_CATALOG_COOLDOWN_SECONDS=120
PUBLIC_REFRESH_DATASET_COOLDOWN_SECONDS=600
# Public refreshes never download datasets the portal advertises with more than
# this many rows (1..10000000); the scheduled or admin sync handles those. A public
# press also re-downloads at most 5 datasets (hard-coded, no variable).
PUBLIC_REFRESH_MAX_RECORDS=100000

# Safety-net TTL (seconds, digits only, 5..86400) of every cached query, so an
# out-of-band change (CLI sync, restore, manual SQL) becomes visible without a
# restart. Per-dataset entries live 6x as long (they are invalidated explicitly
# on every real change). Normally a sync invalidates the caches itself.
CACHE_TTL_SECONDS=300
# URL the sync engine POSTs to (with SYNC_TOKEN) to make the running web server drop
# its caches after a run. Default http://127.0.0.1:$PORT (3000 if PORT is unset);
# docker-compose.yml sets http://app:3000 so one-off `docker compose run app sync`
# containers reach the web container. Set it explicitly when you start the server
# with `next start -p N` (that does not set PORT) or run the CLI from another host.
# APP_INTERNAL_URL=http://127.0.0.1:3000
# Concurrent "heavy" record queries (sorted/searched views of big datasets), integer
# 1..16. Default 4, lowered to (connection_limit - 2) when DATABASE_URL sets one.
# HEAVY_QUERY_LIMIT=4

# --- Sync engine -------------------------------------------------------------
# Datasets synced in parallel AND portal requests in flight; integer 1..10.
# Keep the database pool at least this + 6 (see DB_POOL_SIZE).
SYNC_CONCURRENCY=3
# Other tunables, defaults shown (milliseconds; out-of-range values are clamped):
# SYNC_DELAY_MS=250                  # gap between request starts, 0..10000
# SYNC_REQUEST_TIMEOUT_MS=30000      # catalog request deadline, 100..600000
# SYNC_EXPORT_TIMEOUT_MS=120000      # dataset export deadline, 100..1800000
# SYNC_RETRY_BASE_MS=1000            # exponential backoff base, 0..60000
# Sent as the User-Agent of every portal request:
# USER_AGENT="nabd-albahrain/1.0 (independent open-data dashboard; contact via hekkapp.com)"
# Point the sync at another OpenDataSoft API, e.g. the offline mock
# (`pnpm mock:ods` listens on 4010 by default):
# ODS_BASE_URL=https://data.gov.bh/api/explore/v2.1
# ODS_BASE_URL=http://127.0.0.1:4010/api/explore/v2.1

# --- Docker / compose only (docker-compose.yml reads these; all optional) -----
# Password of the bundled Postgres. Compose derives the app's DATABASE_URL from it
# (so a DATABASE_URL above is ignored under compose). Use hex (`openssl rand -hex 16`):
# it is placed inside a URL. The default matches databases created by older versions;
# for a NEW database set a random value BEFORE the first `docker compose up`. The
# password is baked into the data volume at first start: changing it later means
# ALTER USER inside the database, not editing this file.
# POSTGRES_PASSWORD=nabd
# Prisma pool size for the app (default 12). At least SYNC_CONCURRENCY + 6 (the app
# warns at start when it is smaller): each dataset being synced pins one connection
# for its whole write transaction, and the heartbeat, progress writer,
# /api/freshness and page queries need the rest. Do not "fix" starvation with a
# longer pool_timeout.
# DB_POOL_SIZE=12
# Node flags for the app container (compose passes them as NODE_OPTIONS). A V8 heap
# cap makes memory growth fail fast instead of swapping; three 300k-row datasets in
# flight were measured at a ~0.6-0.8 GB process peak (RSS, Next baseline included).
# Pair the cap with APP_MEM_LIMIT of at least heap + 300-400 MB (Prisma engine,
# response buffers, Next baseline): ~1.5 GB for the two lines below. A limit under
# ~1.2 GB with SYNC_CONCURRENCY >= 3 gets OOM-killed mid-sync, which strands the sync
# lock for the 10-minute stale window.
# APP_NODE_OPTIONS=--max-old-space-size=1024
# APP_MEM_LIMIT=1536m
#
# GIT_SHA (the revision shown as `version` by /api/health/ready) is a BUILD arg, not
# a runtime variable: pass it on the command line, do not put it in this file (a
# stale value here would report the wrong build). `.git` is not in the build context.
#   GIT_SHA=$(git rev-parse --short HEAD) docker compose up -d --build
#
# The first sync after a deploy downloads every dataset: run it as a one-off
# container (own pool, own memory, same database lock) before the tunnel is live:
#   docker compose run --rm app sync
# (the scheduler would also do it ~60 s after boot when AUTO_SYNC_INTERVAL_MINUTES > 0).

# --- Development and tests only (never needed in production) ------------------
# The offline mock portal (`pnpm mock:ods`):
# MOCK_ODS_PORT=4010         # listen port
# MOCK_ODS_BIG=1             # add a large dataset (see MOCK_ODS_BIG_ROWS)
# MOCK_ODS_BIG_ROWS=120000   # its row count
# The integration tests (`RUN_INTEGRATION=1 pnpm test`; export DATABASE_URL of a THROWAWAY
# migrated database first, they TRUNCATE Dataset/SyncLog/SyncLock/SyncState there):
# RUN_INTEGRATION=1          # opt in
# INTEGRATION_ALLOW_WIPE=1   # allow wiping a database named exactly "nabd": never do this
# DEBUG_INTEGRATION=1        # show the engine's log output while testing

# --- Deliberately NOT in this file ------------------------------------------
# PORT / HOSTNAME / NODE_ENV: set by the Dockerfile (3000 / 0.0.0.0 / production).
# Putting PORT here would override the image's value and break the published port
# mapping 127.0.0.1:3000:3000.
# NEXT_MANUAL_SIG_HANDLE: the Dockerfile sets it so a container stop mid-sync aborts the
# run and frees the lock at once. Any non-empty value (even `0`) turns it on, so set it
# to 1 or leave it unset; it only matters outside Docker.
