# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: ignore every .env* (.env.production, .env.staging, ...) so real
# secrets cannot be committed or COPY'd into an image; only the template is tracked
.env*
!.env.example

# local compose override (copy of docker-compose.override.example.yml)
docker-compose.override.yml

# build outputs & test artifacts
/dist
/playwright-report
/test-results
/blob-report

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/dist
